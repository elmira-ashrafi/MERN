# copy to .env and fill in

PORT=8000
NODE_ENV=development

MONGODB=mongodb://127.0.0.1:27017/mern
JWT_SECRET=replace-with-a-long-random-string

# relative paths are resolved against the server directory, not the current working directory
UPLOAD_DIR=uploads

# comma separated list used for the CORS allowlist
CLIENT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-app-password

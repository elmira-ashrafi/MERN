# copy to .env.local and adjust if the backend does not run on 127.0.0.1:8000

PORT=3000

# where the proxy in server.js forwards /api and /uploads
API_TARGET=http://127.0.0.1:8000

# absolute base used by getServerSideProps only, the browser uses the relative /api path
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
